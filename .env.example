# Client (React) — public, safe to expose in the bundle. Must be prefixed
# REACT_APP_ or Create React App won't inline them.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Serverless proxy (api/*.js on Vercel) — server-side only, never prefixed
# REACT_APP_, never imported by anything under src/.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://your-deployed-app.vercel.app

# GitHub Actions scraper job secrets (set as repo secrets, not here) —
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY. The scraper needs no Purdue
# session/auth of any kind — see README.
